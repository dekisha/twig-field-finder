{
  "$comment": "Seed data converted from 'Getting field values in Twig' (Confluence export). Placeholders: __ENTITY__ = entity variable (node, paragraph, media, term, user...), __FIELD__ = field machine name, __SUBFIELD__ = a field on the referenced entity. 'content.' snippets are render-array access and do not change with entity. Entries with a 'review' key were corrected or are uncertain and must be verified on a real Drupal 10/11 site before publishing.",
  "helperFilters": [
    { "name": "field_label", "module": "twig_field_value", "description": "Returns the field label value." },
    { "name": "field_value", "module": "twig_field_value", "description": "Returns the render array of the field value(s) without the field wrappers." },
    { "name": "field_raw", "module": "twig_field_value", "description": "Returns raw field properties value(s)." },
    { "name": "field_target_entity", "module": "twig_field_value", "description": "Returns the referenced entity object(s) of an entity reference field." }
  ],
  "modules": {
    "twig_field_value": "https://www.drupal.org/project/twig_field_value",
    "bamboo_twig": "https://www.drupal.org/project/bamboo_twig",
    "twig_tweak": "https://www.drupal.org/project/twig_tweak",
    "config_pages": "https://www.drupal.org/project/config_pages"
  },
  "entries": [
    {
      "id": "entity-id", "group": "Entity basics", "label": "ID", "usesField": false,
      "raw": ["{{ __ENTITY__.id() }}"]
    },
    {
      "id": "entity-title", "group": "Entity basics", "label": "Title / label", "usesField": false,
      "raw": ["{{ __ENTITY__.label() }}"],
      "render": ["{{ label.0['#context'].value }}"],
      "helper": [{ "code": "{{ label|field_raw.value }}", "module": "twig_field_value" }],
      "notes": "The `label` variable is available in node.html.twig."
    },
    {
      "id": "entity-url", "group": "Entity basics", "label": "URL", "usesField": false,
      "raw": ["{{ url }}"],
      "notes": "`url` is a template variable provided in node.html.twig, not an entity property."
    },
    {
      "id": "contextual-links", "group": "Entity basics", "label": "Contextual links", "usesField": false,
      "raw": ["{{ title_suffix.contextual_links }}"]
    },
    {
      "id": "bundle-machine-name", "group": "Entity basics", "label": "Bundle (content type) machine name", "usesField": false,
      "raw": ["{{ __ENTITY__.bundle() }}"]
    },
    {
      "id": "bundle-human-name", "group": "Entity basics", "label": "Content type human name", "usesField": false,
      "raw": ["{{ node.type.entity.label() }}"],
      "notes": "Node only. Other entity types store their bundle differently."
    },
    {
      "id": "published-on", "group": "Entity basics", "label": "Published on", "usesField": false,
      "raw": ["{{ node.published_at.value|date('d.m.Y') }}", "{{ node.created.value|date('d.m.Y') }}"],
      "helper": [
        { "code": "{{ content.published_at|field_value|first['#text'] }}", "module": "twig_field_value" },
        { "code": "{{ content.published_at|field_raw.value }}", "module": "twig_field_value" }
      ],
      "review": "`published_at` comes from the contrib Publication Date module. Core has `created` and `changed`. Label the module or keep only the core version."
    },
    {
      "id": "check-empty", "group": "Utilities", "label": "Check if field is empty",
      "raw": ["{% if not __ENTITY__.__FIELD__.isEmpty() %}\n  {{ content.__FIELD__ }}\n{% endif %}"],
      "render": ["{% set content_render = content.__FIELD__|render %}\n{% if content_render|trim %}\n  {{ content_render }}\n{% endif %}"],
      "notes": "Use the render-and-trim pattern when isEmpty() is not reliable (e.g. field present but formatter outputs nothing). It avoids rendering the field twice."
    },
    {
      "id": "field-label", "group": "Utilities", "label": "Field label (any field type)",
      "raw": ["{{ __ENTITY__.__FIELD__.fieldDefinition.label }}"],
      "helper": [{ "code": "{{ content.__FIELD__|field_label }}", "module": "twig_field_value" }],
      "review": "Original raw snippet was `node.field_name.entity.label`, which returns the label of the referenced entity, not the field label. Replaced with fieldDefinition.label; verify it passes the Twig sandbox."
    },
    {
      "id": "body", "group": "Text", "label": "Body",
      "raw": ["{{ __ENTITY__.body.value }}"],
      "render": ["{{ content.body }}"],
      "helper": [{ "code": "{{ content.body|field_value }}", "module": "twig_field_value" }],
      "usesField": false,
      "notes": "Raw `.value` outputs unfiltered, escaped markup. Prefer `content.body` so text formats and cache metadata apply."
    },
    {
      "id": "body-summary", "group": "Text", "label": "Body (summary)", "usesField": false,
      "raw": ["{{ __ENTITY__.body.summary }}"]
    },
    {
      "id": "text-plain", "group": "Text", "label": "Text (plain, plain long)",
      "raw": ["{{ __ENTITY__.__FIELD__.value }}"],
      "render": ["{{ content.__FIELD__[0]['#context'].value }}"],
      "helper": [{ "code": "{{ content.__FIELD__|field_value|first['#context'].value }}", "module": "twig_field_value" }]
    },
    {
      "id": "text-formatted", "group": "Text", "label": "Text (formatted, formatted long)",
      "raw": ["{{ __ENTITY__.__FIELD__.value }}"],
      "render": ["{{ content.__FIELD__ }}"],
      "helper": [{ "code": "{{ content.__FIELD__|field_value }}", "module": "twig_field_value" }],
      "notes": "Raw `.value` bypasses the text format filter. Use the render array for formatted text."
    },
    {
      "id": "text-summary", "group": "Text", "label": "Text (with summary) — summary",
      "raw": ["{{ __ENTITY__.__FIELD__.summary }}"]
    },
    {
      "id": "list", "group": "Simple values", "label": "List (text / integer / float)",
      "raw": ["{{ __ENTITY__.__FIELD__.value }}"],
      "render": ["{{ content.__FIELD__ }}"],
      "notes": "Raw `.value` returns the stored key; the render array shows the allowed-value label."
    },
    {
      "id": "boolean", "group": "Simple values", "label": "Boolean",
      "raw": ["{{ __ENTITY__.__FIELD__.value }}", "{{ __ENTITY__.__FIELD__.0.getPossibleOptions() }}"],
      "render": ["{{ content.__FIELD__[0]['#markup'] }}"],
      "helper": [{ "code": "{{ content.__FIELD__|field_value|first['#markup'] }}", "module": "twig_field_value" }]
    },
    {
      "id": "number", "group": "Simple values", "label": "Number", "raw": ["{{ __ENTITY__.__FIELD__.value }}"]
    },
    {
      "id": "email", "group": "Simple values", "label": "Email", "raw": ["{{ __ENTITY__.__FIELD__.value }}"]
    },
    {
      "id": "phone", "group": "Simple values", "label": "Telephone", "raw": ["{{ __ENTITY__.__FIELD__.value }}"]
    },
    {
      "id": "date", "group": "Simple values", "label": "Date",
      "raw": ["{{ __ENTITY__.__FIELD__.value }}", "{{ __ENTITY__.__FIELD__.date|date('d.m.Y') }}"],
      "helper": [{ "code": "{{ content.__FIELD__|field_value|first['#text'] }}", "module": "twig_field_value" }],
      "review": "Added `.date|date()` variant (DateTimeItem computed `date` property). Verify output."
    },
    {
      "id": "link-title", "group": "Link", "label": "Link — title",
      "raw": ["{{ __ENTITY__.__FIELD__.title }}"],
      "render": ["{{ content.__FIELD__.0['#title'] }}"],
      "helper": [
        { "code": "{{ content.__FIELD__|field_value|first['#title'] }}", "module": "twig_field_value" },
        { "code": "{{ content.__FIELD__|field_raw.title }}", "module": "twig_field_value" }
      ],
      "review": "Original raw snippet was `node.field_name.0.value.title`; `value` is not a link property. Corrected to `.title`."
    },
    {
      "id": "link-url", "group": "Link", "label": "Link — URL",
      "raw": ["{{ __ENTITY__.__FIELD__.0.url|render }}"],
      "render": ["{{ content.__FIELD__.0['#url']|render }}"],
      "helper": [{ "code": "{{ content.__FIELD__|field_value|first['#url']|render }}", "module": "twig_field_value" }]
    },
    {
      "id": "link-plain-text", "group": "Link", "label": "Link — plain text",
      "render": ["{{ content.__FIELD__.0['#plain_text'] }}"],
      "helper": [{ "code": "{{ content.__FIELD__|field_value|first['#plain_text'] }}", "module": "twig_field_value" }],
      "review": "`#plain_text` only exists with specific formatter settings (URL only / plain text). Confirm which formatter produces it."
    },
    {
      "id": "link-external", "group": "Link", "label": "Link — is external",
      "raw": ["{{ __ENTITY__.__FIELD__.0.url.external }}"]
    },
    {
      "id": "link-options", "group": "Link", "label": "Link — options (attributes)",
      "raw": ["{{ __ENTITY__.__FIELD__.0.options }}"],
      "helper": [{ "code": "{{ content.__FIELD__|field_value|first['#options'] }}", "module": "twig_field_value" }]
    },
    {
      "id": "image-uri", "group": "Image", "label": "Image — URI",
      "raw": ["{{ __ENTITY__.__FIELD__.entity.uri.value }}"],
      "render": ["{{ content.__FIELD__['#items'].entity.uri.value }}"],
      "helper": [{ "code": "{{ content.__FIELD__|field_target_entity.uri.value }}", "module": "twig_field_value" }],
      "review": "Original raw was `.entity.fileuri` (not a File property) — corrected to `.entity.uri.value`. Helper snippet was marked '??' in the original doc; test it."
    },
    {
      "id": "image-path", "group": "Image", "label": "Image — public URL / image style",
      "raw": ["{{ file_url(__ENTITY__.__FIELD__.entity.uri.value) }}"],
      "render": ["{{ file_url(content.__FIELD__['#items'].entity.uri.value) }}"],
      "helper": [
        { "code": "{{ bamboo_render_image_style(__ENTITY__.__FIELD__.entity.field_media_image.entity.uri.value, 'page_header') }}", "module": "bamboo_twig" },
        { "code": "{{ __ENTITY__.__FIELD__.entity.uri.value|image_style('thumbnail') }}", "module": "twig_tweak" }
      ],
      "notes": "The bamboo example assumes a media reference field whose media has `field_media_image`.",
      "review": "Original raw used `node.field_name['#items']`, which is render-array syntax on an entity. Corrected to `.entity.uri.value`."
    },
    {
      "id": "image-alt", "group": "Image", "label": "Image — alt", "raw": ["{{ __ENTITY__.__FIELD__.alt }}"]
    },
    {
      "id": "image-title", "group": "Image", "label": "Image — title", "raw": ["{{ __ENTITY__.__FIELD__.title }}"],
      "review": "Original doc had `.alt` here (copy/paste). Corrected to `.title`."
    },
    {
      "id": "image-dimensions", "group": "Image", "label": "Image — width / height",
      "raw": ["{{ __ENTITY__.__FIELD__.width }}", "{{ __ENTITY__.__FIELD__.height }}"]
    },
    {
      "id": "file-path", "group": "File", "label": "File — URI / URL",
      "raw": ["{{ __ENTITY__.__FIELD__.entity.getFileUri() }}", "{{ file_url(__ENTITY__.__FIELD__.entity.uri.value) }}"],
      "render": ["{{ file_url(content.__FIELD__['#items'].entity.uri.value) }}"],
      "review": "Original was `node.field_name.0.getFileUri()`; getFileUri() lives on the File entity, not the field item. Corrected to `.entity.getFileUri()`."
    },
    {
      "id": "file-name", "group": "File", "label": "File — filename",
      "raw": ["{{ __ENTITY__.__FIELD__.entity.getFilename() }}"],
      "review": "Corrected from `.0.getFilename()` — method is on the File entity."
    },
    {
      "id": "file-size", "group": "File", "label": "File — size",
      "raw": ["{{ __ENTITY__.__FIELD__.entity.getSize() }}"],
      "review": "Corrected from `.0.getSize()` — method is on the File entity."
    },
    {
      "id": "file-upload-location", "group": "File", "label": "File — upload location",
      "raw": ["{{ __ENTITY__.__FIELD__.0.getUploadLocation() }}"]
    },
    {
      "id": "file-description", "group": "File", "label": "File — description",
      "raw": ["{{ __ENTITY__.__FIELD__.description }}"]
    },
    {
      "id": "file-mime", "group": "File", "label": "File / media — MIME type",
      "raw": ["{{ __ENTITY__.__FIELD__.entity.getMimeType() }}"],
      "review": "Moved from the entity reference group. getMimeType() exists on File entities; on a media reference you need `.entity.field_media_file.entity.getMimeType()`."
    },
    {
      "id": "address", "group": "Address", "label": "Address (address module)",
      "raw": [
        "{{ __ENTITY__.__FIELD__.address_line1 }}",
        "{{ __ENTITY__.__FIELD__.address_line2 }}",
        "{{ __ENTITY__.__FIELD__.postal_code }}",
        "{{ __ENTITY__.__FIELD__.locality }}",
        "{{ __ENTITY__.__FIELD__.country_code }}"
      ],
      "render": [
        "{{ content.__FIELD__.0.address_line1['#value'] }}",
        "{{ content.__FIELD__.0.address_line2['#value'] }}",
        "{{ content.__FIELD__.0.postal_code['#value'] }}",
        "{{ content.__FIELD__.0.locality['#value'] }}",
        "{{ content.__FIELD__.0.country['#value'] }}"
      ],
      "helper": [
        { "code": "{{ content.__FIELD__|field_value.0.address_line1['#value'] }}", "module": "twig_field_value" },
        { "code": "{{ content.__FIELD__|field_value.0.locality['#value'] }}", "module": "twig_field_value" }
      ],
      "review": "Original used `.value.address_line1` and `.locality.name` / `.country.name`. AddressItem exposes properties directly (`address_line1`, `locality`, `country_code`). Render-array keys depend on the formatter — verify all three columns."
    },
    {
      "id": "author-username", "group": "User", "label": "Author — username", "usesField": false,
      "raw": ["{{ __ENTITY__.uid.entity.name.value }}", "{{ __ENTITY__.getOwner().getDisplayName() }}"]
    },
    {
      "id": "author-custom-field", "group": "User", "label": "Author — custom user field", "usesField": true,
      "raw": ["{{ __ENTITY__.uid.entity.__FIELD__.value }}"],
      "notes": "Example from the original doc: `firstname`, a custom field on the user entity."
    },
    {
      "id": "media-id", "group": "Media", "label": "Media — ID",
      "raw": ["{{ __ENTITY__.__FIELD__.target_id }}", "{{ __ENTITY__.__FIELD__.entity.id() }}"],
      "review": "Original was `.0.entity.mid` (returns a field list, not a scalar). Replaced with target_id / id()."
    },
    {
      "id": "media-bundle", "group": "Media", "label": "Media — bundle",
      "raw": ["{{ __ENTITY__.__FIELD__.entity.bundle() }}"]
    },
    {
      "id": "media-name", "group": "Media", "label": "Media — name",
      "raw": ["{{ __ENTITY__.__FIELD__.entity.name.value }}", "{{ __ENTITY__.__FIELD__.entity.label() }}"]
    },
    {
      "id": "media-alt", "group": "Media", "label": "Media image — alt",
      "raw": ["{{ __ENTITY__.__FIELD__.entity.field_media_image.alt }}"],
      "helper": [{ "code": "{{ content.__FIELD__|field_target_entity.field_media_image.alt }}", "module": "twig_field_value" }]
    },
    {
      "id": "ref-id", "group": "Entity reference", "label": "Reference — target ID",
      "raw": ["{{ __ENTITY__.__FIELD__.target_id }}", "{{ __ENTITY__.__FIELD__.entity.id() }}"],
      "review": "Original was `.0.entity.nid`, which only works for node targets (terms use tid). target_id works for every entity type."
    },
    {
      "id": "ref-label", "group": "Entity reference", "label": "Reference — label (term name / node title)",
      "raw": ["{{ __ENTITY__.__FIELD__.entity.label() }}", "{{ __ENTITY__.__FIELD__.entity.name.value }}", "{{ __ENTITY__.__FIELD__.entity.title.value }}"],
      "render": ["{{ content.__FIELD__[0]['#title'] }}"],
      "helper": [
        { "code": "{{ content.__FIELD__|field_target_entity.label }}", "module": "twig_field_value" },
        { "code": "{{ content.__FIELD__|field_target_entity.title.value }}", "module": "twig_field_value" }
      ],
      "notes": "label() works for any target type; `name` is for terms, `title` for nodes.",
      "review": "Original also listed `content.field_name[0]['#name']` — not a key the default label formatter produces. Removed; verify."
    },
    {
      "id": "ref-body", "group": "Entity reference", "label": "Reference — body / description",
      "raw": ["{{ __ENTITY__.__FIELD__.entity.body.value }}", "{{ __ENTITY__.__FIELD__.entity.description.value }}"],
      "notes": "`body` for nodes, `description` for taxonomy terms.",
      "review": "Original render snippet `content.field_name[0]['#body']` removed — not produced by core formatters."
    },
    {
      "id": "ref-url", "group": "Entity reference", "label": "Reference — URL",
      "raw": ["{{ path('entity.node.canonical', {'node': __ENTITY__.__FIELD__.target_id}) }}", "{{ path('entity.taxonomy_term.canonical', {'taxonomy_term': __ENTITY__.__FIELD__.target_id}) }}"],
      "render": ["{{ content.__FIELD__[0]['#url'] }}"],
      "helper": [{ "code": "{{ path('entity.node.canonical', {'node': content.__FIELD__|field_target_entity.id}) }}", "module": "twig_field_value" }],
      "review": "Original raw `.0.entity.url` relied on Entity::url(), removed in Drupal 9, and toUrl() is not allowed by the Twig sandbox. Replaced with path()."
    },
    {
      "id": "ref-subfield", "group": "Entity reference", "label": "Reference — field on referenced entity",
      "raw": ["{{ __ENTITY__.__FIELD__.entity.__SUBFIELD__.value }}"],
      "helper": [{ "code": "{{ content.__FIELD__|field_target_entity.__SUBFIELD__.value }}", "module": "twig_field_value" }]
    },
    {
      "id": "ref-image", "group": "Entity reference", "label": "Reference — image on referenced entity",
      "raw": [
        "{{ file_url(__ENTITY__.__FIELD__.entity.__SUBFIELD__.entity.uri.value) }}",
        "{# first item only #}\n{{ file_url(__ENTITY__.__FIELD__.0.entity.__SUBFIELD__.entity.uri.value) }}"
      ],
      "helper": [
        { "code": "{{ bamboo_render_image_style(__ENTITY__.__FIELD__.entity.__SUBFIELD__.entity.uri.value, 'thumbnail') }}", "module": "bamboo_twig" },
        { "code": "{{ bamboo_render_image_style(content.__FIELD__|field_target_entity.__SUBFIELD__.entity.uri.value, 'thumbnail') }}", "module": "bamboo_twig" },
        { "code": "{{ __ENTITY__.__FIELD__.entity.__SUBFIELD__.entity.uri.value|image_style('thumbnail') }}", "module": "twig_tweak" }
      ]
    },
    {
      "id": "paragraph-items-loop", "group": "Paragraphs", "label": "Multi-value paragraphs — inside field template loop", "usesField": true,
      "raw": [
        "{% for item in items %}\n  {{ item.content['#paragraph'].__FIELD__.value }}\n{% endfor %}",
        "{% for item in items %}\n  {{ item.content['#paragraph'].get('__FIELD__').entity.label() }}\n{% endfor %}"
      ],
      "notes": "Use in field--paragraphs--*.html.twig where `items` is available. __FIELD__ is a field on the paragraph."
    },
    {
      "id": "paragraph-parent", "group": "Paragraphs", "label": "Parent entity field value (from a paragraph)",
      "raw": ["{{ paragraph.getParentEntity().__FIELD__.value }}"],
      "notes": "Use in paragraph--*.html.twig.",
      "review": "Original also listed `rocket_get_parent_paragraph()` (project-specific custom function) and `parent_entity` (preprocess-provided variable). Excluded from the public version."
    },
    {
      "id": "config-pages", "group": "Config pages", "label": "Config page field", "usesField": true,
      "helper": [{ "code": "{{ config_pages_field('my_config_page', '__FIELD__', 'full') }}", "module": "config_pages" }]
    }
  ]
}
