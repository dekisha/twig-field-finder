// Cloudflare Workers with static assets (Cloudflare's recommendation for new
// projects). No Worker script: the build output is served as-is.
// Deploy: `pnpm deploy:cloudflare`, or connect the repo in Workers Builds with
// build command `pnpm build` and deploy command `npx wrangler deploy`.
{
  "name": "twig-field-finder",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    // Serves dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page",
    // /fields/link-url → /fields/link-url/ (matches the directory output).
    "html_handling": "auto-trailing-slash",
  },
}
