{
  "name": "twig-field-finder",
  "version": "0.1.0",
  "private": true,
  "description": "Twig Field Finder \u2014 Every Drupal field value in Twig, copy-ready.",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed:split": "tsx scripts/split-seed.ts",
    "verify:dist": "tsx scripts/verify-dist.ts",
    "highlight:build": "tsx scripts/build-twig-grammar.ts && tsx scripts/build-themes.ts",
    "build:apache": "astro build && tsx scripts/write-htaccess.ts",
    "deploy:cloudflare": "astro build && pnpm dlx wrangler@4 deploy",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:dist"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@shikijs/themes": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "fuse.js": "^7.5.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@react-aria/optimize-locales-plugin": "^2.1.0",
    "@shikijs/langs": "^4.5.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
