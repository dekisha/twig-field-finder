---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/paths';
---

<BaseLayout title="Not found" description="This page doesn’t exist.">
  <main id="main" class="mx-auto w-full max-w-2xl px-4 pt-16 pb-24 sm:px-6">
    <p class="font-mono text-sm text-subtle">{'{{ page.status }}'} → 404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      That template variable is empty.
    </h1>
    <p class="mt-3 text-lg text-muted">The page you’re looking for doesn’t exist, or it moved.</p>
    <ul class="mt-8 flex flex-wrap gap-3">
      <li>
        <a
          href={withBase('/')}
          class="inline-flex min-h-10 items-center rounded-lg bg-accent px-4 text-sm font-medium text-accent-ink hover:bg-accent/90"
        >
          Open the builder
        </a>
      </li>
      <li>
        <a
          href={withBase('/fields/')}
          class="inline-flex min-h-10 items-center rounded-lg border border-line-strong bg-surface px-4 text-sm font-medium text-ink hover:border-accent"
        >
          Browse all fields
        </a>
      </li>
    </ul>
  </main>
</BaseLayout>
