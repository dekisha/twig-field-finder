---
import { getEntries, getGroups, getModules } from '@/data/entries';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { describeResults } from '@/lib/browse-filters';
import { APPROACH_LABELS, approachesFor, modulesFor } from '@/lib/entry';
import { withBase } from '@/lib/paths';

const [entries, groups, modules] = await Promise.all([getEntries(), getGroups(), getModules()]);

const sections = groups
  .map((group) => ({ group, entries: entries.filter((e) => e.group === group.id) }))
  .filter((s) => s.entries.length > 0);

const moduleUsage = modules.map((m) => ({
  module: m,
  count: entries.filter((e) => modulesFor(e).includes(m.id)).length,
}));

const selectClass =
  'w-full appearance-none rounded-lg border border-control bg-surface py-2.5 pr-10 pl-3 text-base text-ink focus-visible:border-accent';
---

<BaseLayout
  title="Browse"
  description="Every Drupal field type and property covered by Twig Field Finder, grouped and filterable by contrib module."
>
  <main id="main" class="mx-auto w-full max-w-6xl px-4 pt-10 pb-20 sm:px-6 lg:pt-14">
    <div class="max-w-2xl">
      <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Browse</h1>
      <p class="mt-3 text-lg text-muted">
        Every field type and property, with the approaches each one supports.
      </p>
    </div>

    <form
      data-browse-filters
      hidden
      class="mt-8 grid gap-4 rounded-xl border border-line bg-surface p-4 sm:grid-cols-[1fr_1fr_auto] sm:items-end"
      aria-label="Filter entries"
    >
      <div class="flex flex-col gap-1.5">
        <label for="filter-group" class="text-sm font-medium text-ink">
          Group
        </label>
        <div class="relative">
          <select id="filter-group" name="group" class={selectClass}>
            <option value="">All groups</option>
            {sections.map(({ group, entries: items }) => (
              <option value={group.id}>
                {group.label} ({items.length})
              </option>
            ))}
          </select>
          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            class="pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2 text-muted"
            fill="none"
          >
            <path
              d="m5 8 5 5 5-5"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
            ></path>
          </svg>
        </div>
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="filter-module" class="text-sm font-medium text-ink">
          Contrib module
        </label>
        <div class="relative">
          <select id="filter-module" name="module" class={selectClass}>
            <option value="">Any, or none</option>
            {moduleUsage.map(({ module, count }) => (
              <option value={module.id}>
                {module.name} ({count})
              </option>
            ))}
          </select>
          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            class="pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2 text-muted"
            fill="none"
          >
            <path
              d="m5 8 5 5 5-5"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
            ></path>
          </svg>
        </div>
      </div>
      <button
        type="reset"
        class="min-h-11 rounded-lg px-3 text-sm font-medium text-muted hover:bg-sunken hover:text-ink"
      >
        Clear filters
      </button>
    </form>

    <p data-browse-status role="status" aria-live="polite" class="mt-6 text-sm text-muted">
      {describeResults(entries.length, entries.length)}
    </p>

    <p
      data-browse-empty
      hidden
      class="mt-6 rounded-xl border border-dashed border-line-strong p-8 text-center text-muted"
    >
      No entries match these filters.
    </p>

    <div class="mt-4 grid gap-x-10 gap-y-10 md:grid-cols-2">
      {sections.map(({ group, entries: items }) => (
        <section data-browse-group aria-labelledby={`group-${group.id}`}>
          <h2
            id={`group-${group.id}`}
            class="border-b border-line pb-2 text-xs font-semibold tracking-wider text-subtle uppercase"
          >
            {group.label}
          </h2>
          <ul class="divide-y divide-line">
            {items.map((entry) => {
              const used = modulesFor(entry);
              return (
                <li
                  data-browse-item
                  data-group={entry.group}
                  data-modules={used.join(' ')}
                  class="py-3"
                >
                  <a
                    href={withBase(`/fields/${entry.id}/`)}
                    class="font-medium text-ink decoration-accent decoration-2 underline-offset-4 hover:underline"
                  >
                    {entry.label}
                  </a>
                  <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
                    <span>
                      {approachesFor(entry)
                        .map((a) => APPROACH_LABELS[a])
                        .join(' · ')}
                    </span>
                    {used.length > 0 && (
                      <span class="font-mono text-xs">
                        <span class="sr-only">Modules: </span>
                        {used.join(', ')}
                      </span>
                    )}
                  </p>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>

<script>
  import { initBrowseFilters } from '@/scripts/browse-filters';

  initBrowseFilters();
</script>
