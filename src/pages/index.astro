---
import { SnippetBuilder } from '@/components/builder/SnippetBuilder';
import { getEntries, getGroups, getModules, SHOW_REVIEW } from '@/data/entries';
import BaseLayout from '@/layouts/BaseLayout.astro';

const [entries, groups, modules] = await Promise.all([getEntries(), getGroups(), getModules()]);

/** Shown on first visit: it has every approach, several snippets and a note. */
const DEFAULT_ENTRY = 'link-title';
---

<BaseLayout>
  <main id="main" class="mx-auto w-full max-w-6xl px-4 pt-10 pb-20 sm:px-6 lg:pt-14">
    <div class="mb-10 max-w-2xl">
      <h1 class="text-3xl font-semibold tracking-tight text-balance text-ink sm:text-4xl">
        Every Drupal field value in Twig, copy-ready.
      </h1>
      <p class="mt-3 text-lg text-pretty text-muted">
        Pick what you need, type your field’s machine name, and copy the exact Twig path: raw entity
        access, the render array, or a helper module.
      </p>
    </div>
    <SnippetBuilder
      client:load
      entries={entries}
      groups={groups}
      modules={modules}
      defaultEntry={DEFAULT_ENTRY}
      showReview={SHOW_REVIEW}
    />
  </main>
</BaseLayout>
