---
import { Font } from 'astro:assets';

import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { withBase } from '@/lib/paths';
import { THEME_STORAGE_KEY } from '@/lib/theme';
import '@/styles/global.css';

interface Props {
  /** Page name; rendered as `{title} — Twig Field Finder`. Omit for the home page. */
  title?: string;
  description?: string;
}

const SITE_NAME = 'Twig Field Finder';
const TAGLINE = 'Every Drupal field value in Twig, copy-ready.';

const { title, description = TAGLINE } = Astro.props;
const fullTitle = title ? `${title} — ${SITE_NAME}` : `${SITE_NAME} — ${TAGLINE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Validated in astro.config.ts, which also opens the CSP for Google's hosts.
const gaId = import.meta.env.PUBLIC_GA_ID as string | undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- Apply a stored theme before first paint (no flash). Mirrors src/scripts/theme-toggle.ts. -->
    <script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
      try {
        const theme = localStorage.getItem(key);
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {
        // Storage unavailable: follow the system theme.
      }
    </script>
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- Only the UI font is preloaded: it carries the LCP text. The code font
         swaps in with metric-matched fallbacks, so it causes no layout shift. -->
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body class="flex min-h-dvh flex-col antialiased">
    <a
      href="#main"
      class="sr-only rounded-md bg-accent px-3 py-2 text-sm font-medium text-accent-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <SiteHeader />
    <div class="flex-1">
      <slot />
    </div>
    <SiteFooter />
  </body>
</html>
