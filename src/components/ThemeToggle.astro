---
const OPTIONS = [
  {
    value: 'system',
    label: 'System',
    icon: '<rect x="3" y="4" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M7 17h6M10 14v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  },
  {
    value: 'light',
    label: 'Light',
    icon: '<circle cx="10" cy="10" r="3.25" stroke="currentColor" stroke-width="1.5"/><path d="M10 2.5v1.75M10 15.75v1.75M17.5 10h-1.75M4.25 10H2.5m12.8-5.3-1.24 1.24M5.94 14.06 4.7 15.3m10.6 0-1.24-1.24M5.94 5.94 4.7 4.7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  },
  {
    value: 'dark',
    label: 'Dark',
    icon: '<path d="M16.5 12.2A6.75 6.75 0 0 1 7.8 3.5a6.75 6.75 0 1 0 8.7 8.7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
  },
];
---

<!--
  Native radios: arrow keys move between options, and the group is announced as
  "Theme". The visible icons have text labels for assistive tech and tooltips.
-->
<fieldset class="flex items-center rounded-full border border-control bg-sunken p-0.5">
  <legend class="sr-only">Theme</legend>
  {OPTIONS.map(({ value, label, icon }) => (
    <label
      title={label}
      class="flex size-7 cursor-pointer items-center justify-center rounded-full text-muted transition-colors hover:text-ink has-checked:bg-surface has-checked:text-ink has-checked:shadow-sm has-checked:ring-1 has-checked:ring-control has-focus-visible:outline-2 has-focus-visible:outline-focus"
    >
      <input type="radio" name="theme" value={value} class="sr-only" checked={value === 'system'} />
      <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4" fill="none" set:html={icon} />
      <span class="sr-only">{label}</span>
    </label>
  ))}
</fieldset>

<script>
  import { initThemeToggle } from '@/scripts/theme-toggle';

  initThemeToggle();
</script>
