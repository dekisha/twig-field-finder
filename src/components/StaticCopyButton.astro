---
import { COPY_BUTTON_CLASS, COPY_LABELS } from '@/components/copy-button';

interface Props {
  text: string;
  /** Accessible name when it differs from the visible label. */
  label?: string | undefined;
  variant?: keyof typeof COPY_BUTTON_CLASS;
  /** Visible label. */
  visible?: string;
}

const { text, label, variant = 'primary', visible = COPY_LABELS.idle } = Astro.props;
---

<!-- Hidden until src/scripts/copy-buttons.ts wires it up: no JS, no dead button. -->
<button type="button" class={COPY_BUTTON_CLASS[variant]} data-copy={text} aria-label={label} hidden>
  <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4" fill="none">
    <rect
      x="7"
      y="7"
      width="9"
      height="9"
      rx="1.75"
      stroke="currentColor"
      stroke-width="1.5"
    ></rect>
    <path
      d="M13 7V5.75C13 4.78 12.22 4 11.25 4h-5.5C4.78 4 4 4.78 4 5.75v5.5c0 .97.78 1.75 1.75 1.75H7"
      stroke="currentColor"
      stroke-width="1.5"
    ></path>
  </svg>
  <span data-copy-label aria-hidden={label !== undefined ? 'true' : undefined}>
    {visible}
  </span>
</button>
